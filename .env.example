# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# Secret path component for webhook endpoint (e.g. /telegram/<SECRET>)
TELEGRAM_WEBHOOK_SECRET=your_custom_webhook_secret_here

# Public URL of the server (required for Telegram Webhook and generated links)
SERVER_BASE_URL=https://your-domain.com

# Flask Settings
FLASK_DEBUG=0
PORT=5000
SECRET_KEY=change_this_to_a_random_secure_key

# Session expiration in hours (default: 24)
SESSION_EXPIRATION_HOURS=24
